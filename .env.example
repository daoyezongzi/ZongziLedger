# Example env overrides (safe to upload)
APP_ENV=local
DEBUG=false

# Business rule: first line must be #记账 + 8 digits
ORDER_ID_REQUIRED=true
ORDER_ID_DIGITS=8
ORDER_ID_REQUIRE_HASH=true

# Daily settlement mode
DAILY_SETTLEMENT_MODE=true
DAILY_FORCE_REINITIALIZE=false
DAILY_RECENT_MESSAGE_LIMIT=3
DAILY_SEEN_RETENTION_DAYS=30

# Paths
DATA_PATH=data/ledger.local.csv
JSON_OUTPUT_ENABLED=true
JSON_OUTPUT_PATH=data/ledger_details.local.json
JSON_OUTPUT_APPEND_HISTORY=true
DAILY_SETTLEMENT_STATE_PATH=data/daily_settlement_state.local.json
MESSAGE_HASH_STATE_PATH=data/message_hash_state.local.json
LOG_DIR=logs
