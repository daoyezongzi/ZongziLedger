# ================================
# 本机覆盖模板（.env.example）
# 仅放“覆盖 config.yaml 的本机参数”示例，复制为 .env 后按需启用
# ================================

# 环境标记（不会覆盖到 config）
APP_ENV=local
DEBUG=true
DO_NOT_UPLOAD=true

# --- 敏感/账号绑定 ---
# Dify 远端工作流 API 地址与密钥
DIFY_REMOTE_API_URL=
DIFY_REMOTE_API_KEY=

# WeTrace 鉴权与目标会话标识
WETRACE_AUTH_TOKEN=
WETRACE_TALKER_ID=

# --- 本机抓取绑定（可选覆盖） ---
CAPTURE_BACKEND=uia
WECHAT_WINDOW_NAME=
WECHAT_WINDOW_NAME_STRICT=true
WECHAT_CLASS_NAME=WeChatMainWndForPC,Qt51514QWindowIcon
WECHAT_WINDOW_CONTROL_TYPE=Window
WECHAT_WINDOW_FOCUSABLE=true
MESSAGE_LIST_NAME=消息
MESSAGE_PANE_NAME=Weixin
MESSAGE_PANE_CLASS_NAME=MMUIRenderSubWindowHW

# --- 本地运行路径（可选覆盖） ---
DATA_PATH=runtime_local/ledger.local.csv
JSON_OUTPUT_PATH=runtime_local/ledger_details.local.json
DAILY_SETTLEMENT_STATE_PATH=runtime_local/daily_settlement_state.local.json
MESSAGE_HASH_STATE_PATH=runtime_local/message_hash_state.local.json
LOG_DIR=runtime_local/logs
WETRACE_STATE_PATH=runtime_local/wetrace_state.local.json
