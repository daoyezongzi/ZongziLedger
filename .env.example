# Local test only - DO NOT UPLOAD
APP_ENV=local
DEBUG=true
DO_NOT_UPLOAD=true

# Business rule
ORDER_ID_REQUIRED=true
ORDER_ID_DIGITS=8
ORDER_ID_REQUIRE_HASH=true

# Daily settlement
DAILY_SETTLEMENT_MODE=true
DAILY_FORCE_REINITIALIZE=false
DAILY_RECENT_MESSAGE_LIMIT=3
DAILY_SEEN_RETENTION_DAYS=30

# Local paths
DATA_PATH=data/ledger.local.csv
JSON_OUTPUT_ENABLED=true
JSON_OUTPUT_PATH=data/ledger_details.local.json
JSON_OUTPUT_APPEND_HISTORY=true
DAILY_SETTLEMENT_STATE_PATH=runtime_local/daily_settlement_state.local.json
MESSAGE_HASH_STATE_PATH=runtime_local/message_hash_state.local.json
LOG_DIR=runtime_local/logs

# Runtime knobs
MAX_MESSAGES=30
MESSAGE_HASH_WINDOW_SECONDS=120

# Local image ingest
VISION_ENABLED=false
VISION_INBOX_DIR=data/vision_inbox
VISION_STATE_PATH=data/vision_ingest_state.local.json
VISION_REVIEW_QUEUE_PATH=data/review_queue.local.jsonl
VISION_OCR_PROVIDER=tesseract
VISION_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp,.bmp
VISION_MAX_IMAGES_PER_RUN=50

# Local wetrace ingest
WETRACE_BASE_URL=http://127.0.0.1:5200
WETRACE_AUTH_TOKEN=
WETRACE_TALKER_ID=
WETRACE_TALKER_KEYWORD=
WETRACE_TALKER_LIMIT=20
WETRACE_LIMIT=100
WETRACE_MAX_PAGES=5
WETRACE_REVERSE=true
WETRACE_TEXT_ONLY=true
WETRACE_TEXT_TYPE_VALUES=1
WETRACE_KEYWORD=璁拌处
WETRACE_KEYWORD_CASE_SENSITIVE=false
WETRACE_KEYWORD_SERVER_SIDE=false
WETRACE_DISPATCH_MODE=dify
WETRACE_DIFY_INGEST_URL=
WETRACE_DIFY_TIMEOUT_SECONDS=30
WETRACE_TIMEOUT_SECONDS=20
WETRACE_TRIGGER_SYNC=false
WETRACE_SYNC_FAIL_CLOSED=false
WETRACE_STATE_PATH=data/wetrace_state.local.json
WETRACE_CHATROOMS_PATH=/api/v1/chatrooms
WETRACE_MESSAGES_PATH=/api/v1/messages
WETRACE_SYNC_PATH=/api/v1/system/sync

# Dify bridge API
DIFY_API_HOST=127.0.0.1
DIFY_API_PORT=8787
DIFY_INGEST_URL=
DIFY_APPLY_CAPTURE_SCOPE=false
DIFY_USE_DAILY_SETTLEMENT=false
DIFY_USE_HASH_TIME_WINDOW=true
DIFY_AUDIT_ENABLED=true
DIFY_AUDIT_PATH=data/dify_ingest_audit.local.jsonl
DIFY_RESPONSE_PREVIEW_LIMIT=20
DIFY_INGEST_TIMEOUT_SECONDS=30
DIFY_REMOTE_ENABLED=true
DIFY_REMOTE_PRIORITY=true
DIFY_REMOTE_FALLBACK_LOCAL=false
DIFY_REMOTE_API_URL=
DIFY_REMOTE_API_KEY=
DIFY_REMOTE_TIMEOUT_SECONDS=30
DIFY_REMOTE_RESPONSE_MODE=blocking
DIFY_REMOTE_USER=zongziledger-local
DIFY_REMOTE_USER_AGENT=python-requests/2.32.3
DIFY_REMOTE_INPUT_PAYLOAD_KEY=payload_json
DIFY_REMOTE_INPUT_MESSAGES_KEY=messages_json
DIFY_REMOTE_INPUTS_AS_JSON_TEXT=true

# Dify local receiver
DIFY_LISTEN_HOST=127.0.0.1
DIFY_LISTEN_PORT=18888
DIFY_INGEST_PATH=/api/dify/ingest
DIFY_HEALTH_PATH=/api/health
DIFY_MAX_PAYLOAD_BYTES=2097152
DIFY_SOURCE_ID=dify

# Local review queue
REVIEW_QUEUE_ENABLED=true
REVIEW_QUEUE_PATH=data/review_queue.local.jsonl

# Known store deterministic gate
KNOWN_STORE_LOOKUP_ENABLED=true
KNOWN_STORE_LOOKUP_PATH=dictionaries/known_stores.local.json
KNOWN_STORE_LOOKUP_MAX_MATCHES=3
KNOWN_STORE_GATE_ENABLED=true

